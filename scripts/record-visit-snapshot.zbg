# 记录一次访问量快照到 stats/visits.json —— ZBG 写的（替代原来的 python 脚本）
#
# 用法：
#   node zbg.js scripts/record-visit-snapshot.zbg            # 自己联网读当前累计
#   node zbg.js scripts/record-visit-snapshot.zbg 42         # 手动给一个原始值（方便本地测试）
#
# 为什么要扣“探针”：vercount 的读取接口每调用一次就会让计数 +1。所以这里把“累计读了
# 多少次”记进 probes，点里存的 pv 是扣掉探针后的真实累计值 —— 两次快照相减就是真实新增。

let 接口 = "https://events.vercount.one/api/v2/log"
let 站点 = "https://zbgame001.github.io/"
let 文件 = "stats/visits.json"

# 1) 拿到“原始累计值”：优先用命令行给的，否则自己联网读
let 参数 = args()
let 原始 = null
if len(参数) >= 1 { 原始 = num(参数[0]) }

if 原始 == null {
  let 应答 = await post(接口, { url: 站点, isNewUv: false })
  let 数据块 = pick(应答, "data", null)
  if 数据块 == null {
    echo "读不到当前访问量，放弃这次记录"
    exit(1)
  }
  原始 = num(pick(数据块, "site_pv", 0))
}

# 2) 读旧快照（没有就当新的）
let 今天 = date()
let 旧数据 = { updated: 今天, probes: 0, points: [] }
let 旧文本 = readFile(文件)
if 旧文本 != null and len(trim(旧文本)) > 0 {
  旧数据 = parseJson(旧文本)
}

# 3) 探针 +1，覆盖当天那个点，按日期排好
let 探针 = num(pick(旧数据, "probes", 0)) + 1
let 点集 = []
for 点 in pick(旧数据, "points", []) {
  if 点.d != 今天 { 点集 = push(点集, 点) }
}
点集 = push(点集, { d: 今天, pv: 原始 - 探针 })
点集 = sort(点集, "d")

# 4) 写回
writeFile(文件, toJson({ updated: 今天, probes: 探针, points: 点集 }, 1) + "\n")

echo "原始 " + str(原始) + " - 探针 " + str(探针) + " = " + str(原始 - 探针)
echo readFile(文件)
